# 环境变量配置模板（可选方案之一，另一方案为 trading_system/config_local.py）
# 使用方法：复制本文件为 .env，填写实际值。.env 已加入 .gitignore。
# config.py 优先读取环境变量，config_local.py 可覆盖。

# QQ邮箱SMTP授权码（必填，16位，非QQ密码）
EMAIL_AUTH_CODE=在此填写16位QQ邮箱授权码

# 可选覆盖项
# EMAIL_SENDER=your_qq@qq.com
# EMAIL_RECEIVER=your_qq@qq.com
# EMAIL_SMTP_HOST=smtp.qq.com
# EMAIL_SMTP_PORT=465
# DINGTALK_WEBHOOK=
# WECHAT_WORK_WEBHOOK=
